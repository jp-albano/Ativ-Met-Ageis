# ==============================================================================
# Variáveis de Ambiente da API Java (ApiServer)
# Copie este arquivo para .env local e preencha com os valores desejados.
# NUNCA adicione credenciais reais ao controle de versão (.git) ou logs.
# ==============================================================================

# Endereço e porta do servidor HTTP embutido da API Java (padrões: 127.0.0.1 e 8080)
API_HOST=127.0.0.1
API_PORT=8080

# Origens permitidas pelo CORS (separadas por vírgula)
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# SoundCloud API - Configuração de Autenticação
# Registre sua aplicação em: https://developers.soundcloud.com/
# ------------------------------------------------------------------------------
# Fluxo Recomendado: OAuth 2 Client Credentials (renovação automática gerenciada pelo backend)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Alternativa para testes locais rápidos: token estático (expira em cerca de 1 hora)
SOUNDCLOUD_ACCESS_TOKEN=
