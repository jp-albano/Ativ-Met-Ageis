# Variáveis da API Java (ApiServer). Defina-as no ambiente da sua máquina ou do servidor.
# Nunca coloque credenciais reais neste arquivo nem faça commit delas.

# Endereço da API (padrões: 127.0.0.1 e 8080).
API_HOST=127.0.0.1
API_PORT=8080
# Origens liberadas no CORS, separadas por vírgula.
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SoundCloud — recomendado: credenciais do aplicativo (o token é renovado automaticamente).
# Obtenha em https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Alternativa para testes rápidos: token fixo (expira em cerca de 1 hora).
SOUNDCLOUD_ACCESS_TOKEN=
